# Copy to .env. Node loads it for `npm start` and `npm run bench`.

# The referee. Any random string of at least 16 characters: openssl rand -hex 16
REFEREE_ADMIN_TOKEN=
# PORT=8787
# REFEREE_DB=data/referee.db

# The harness.
# An AgentMail API key on a verified account. The agent under test is given this key.
AGENTMAIL_API_KEY=
# Optional: an inbox the account already has, to send the test email from. Without it the harness creates one.
# SEED_INBOX=name@agentmail.to
# The referee's address as AgentMail can reach it, for example a tunnel's https address.
REFEREE_PUBLIC_URL=
# The referee's address from this machine, if different (e.g. http://localhost:8787).
# REFEREE_URL=http://localhost:8787

# Keys for the models you run. Each run costs tokens.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
