{
  "name": "agentmail-setup-bench",
  "private": true,
  "type": "module",
  "description": "Benchmark of how well AI agents set AgentMail up from its docs alone: a referee and a harness.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "bench": "node --env-file-if-exists=.env src/harness/cli.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/openai": "^4.0.121",
    "ai": "^7.0.177",
    "zod": "^4.6.7"
  }
}
